# Enable Passenger for Python ASGI (Passenger 6.0+ required)
# Use this instead of .htaccess if your GoDaddy server has Passenger 6.0+
PassengerEnabled On
PassengerAppType asgi
PassengerStartupFile passenger_wsgi.py
PassengerAppGroupName aba_app

# Set Python version (adjust based on your cPanel Python selector)
PassengerPython /home/USERNAME/virtualenv/aba/venv/bin/python3

# Application root directory
PassengerAppRoot /home/USERNAME/aba

# Increase startup timeout for slow servers
PassengerStartTimeout 600

# Performance tuning for ASGI
PassengerMinInstances 2
PassengerMaxPoolSize 6
PassengerMaxRequests 1000

# Error handling
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# Security headers
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set X-XSS-Protection "1; mode=block"

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/woff2 "access plus 1 year"
</IfModule>
